# Copy to .env and fill in your values.

# VAPID keys for Web Push. Optional — if left blank, the server generates a
# keypair on first boot and stores it in the database (the same keys persist
# across restarts). Set them explicitly only if you want fixed local keys.
# Generate manually with: go run github.com/SherClockHolmes/webpush-go/cmd/vapid-keygen@latest
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:dev@localhost

# Display name shown as the site heading — customise for your community.
# Examples: "Stop Nyons", "Covoiturage Drôme", "Go-Barjac"
SITE_NAME=Go-Stop

# Minutes after a ride's flex window closes before it disappears from listings (default: 60)
RIDE_GRACE_MINUTES=60

# Max days a notification stays in the in-app inbox (default: 30). It is removed
# earlier when the ride or request it is about expires or is deleted.
NOTIFICATION_RETENTION_DAYS=30

# Reminder pushes for unread notifications about another person's action (contact
# request, accepted request, shared number, contact offer) until read or expired,
# and — at most 2 reminders — for matching rides and the post-ride feedback prompt.
INBOX_REMINDER_INTERVAL_HOURS=3
# No reminders in this local-time window (SERVICE_TZ); "none" to always send.
INBOX_REMINDER_QUIET_HOURS=21-8
